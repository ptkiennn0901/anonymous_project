{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ViMed-Rad VQA annotation",
  "type": "object",
  "required": ["sample_id", "modality", "question_id", "question", "answer", "split", "is_synthetic_example"],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^[a-z_]+_[0-9]{3}$"},
    "modality": {"type": "string", "enum": ["xray", "ct", "mr", "pet_ct"]},
    "question_id": {"type": "string"},
    "question": {"type": "string"},
    "answer": {"type": "string"},
    "answer_type": {"type": "string", "enum": ["open", "closed"]},
    "split": {"type": "string", "enum": ["train", "validation", "test", "example"]},
    "is_synthetic_example": {"type": "boolean"}
  },
  "additionalProperties": false
}
